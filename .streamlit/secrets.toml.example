# ============================================================
# Streamlit Secrets File — FOR LOCAL TESTING ONLY
# NEVER upload this file to GitHub!
# It is already in .gitignore
# ============================================================
#
# HOW TO USE:
# 1. Copy this file and rename to:  secrets.toml  (remove the .example part)
# 2. Fill in your Gemini API key below
# 3. The app will automatically read it — no need to type it every time!
#
# FOR STREAMLIT CLOUD (online deployment):
# 1. Go to your app on share.streamlit.io
# 2. Click "Settings" → "Secrets"
# 3. Paste the content below (with your real API key)
# ============================================================

GEMINI_API_KEY = "AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Replace the above with your real key from:
# https://aistudio.google.com/app/apikey
